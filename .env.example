# --- LLM providers (server-side only, never exposed to the browser) ---

# Anthropic (default provider: Claude Haiku). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (optional second provider). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional overrides ---
# Default provider: "anthropic" (default) or "google"
# ESVL_VENDOR=anthropic
# Model per vendor
# ESVL_MODEL_ANTHROPIC=claude-haiku-4-5
# ESVL_MODEL_GOOGLE=gemini-3.6-flash
