# ── LLM providers (server-side only, never exposed to the browser) ──

# Anthropic — powers the Assistant (chat) tab. https://console.anthropic.com/
# The Week-end and Résultats tabs work WITHOUT any key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — optional second provider. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Your club (defaults = ES Villeneuve-Loubet). Override to run this for any FFBB club. ──
# Only the org id really matters — everything else is auto-discovered from FFBB.
# Find your org id with:  npm run find-club "your club name"
NEXT_PUBLIC_CLUB_ORG_ID=10135
NEXT_PUBLIC_CLUB_SHORT=ESVL
# NEXT_PUBLIC_CLUB_NAME=ES Villeneuve-Loubet Basket   # display fallback; the real name comes from FFBB
# NEXT_PUBLIC_CLUB_LIGUE=sud                          # only used to build the FFBB source link
# NEXT_PUBLIC_CLUB_COMITE=0006
# NEXT_PUBLIC_CLUB_CODE=sud0006003

# ── Metrics (optional) — Upstash Redis REST, counts "Share" clicks. No-op if unset. ──
# From the Upstash console → your Redis DB → "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional LLM overrides ──
# LLM_VENDOR=anthropic            # default provider: "anthropic" or "google"
# LLM_MODEL_ANTHROPIC=claude-haiku-4-5
# LLM_MODEL_GOOGLE=gemini-3.6-flash
